{
  "name": "linkfy",
  "private": true,
  "version": "0.1.0",
  "description": "Inbound LinkedIn automation: comment keyword -> reply -> personalized invite -> qualified DM -> follow-ups",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "npm run build && node --test \"packages/*/dist/**/*.test.js\" \"scripts/*.test.mjs\"",
    "db:generate": "npm run db:generate -w @linkfy/db",
    "db:push": "npm run db:push -w @linkfy/db",
    "init": "npm run init -w @linkfy/agent",
    "agent": "npm run agent -w @linkfy/agent",
    "automation": "npm run automation -w @linkfy/agent --",
    "doctor": "npm run doctor -w @linkfy/agent",
    "update": "git pull --ff-only && npm install",
    "demo": "npm run demo -w @linkfy/agent --"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.2"
  }
}
