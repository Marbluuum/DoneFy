# --- Database (Supabase Postgres) ---
# Supabase > Project Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# --- Agent ---
# Absolute path to the persistent Chrome profile the agent drives.
# Use a dedicated profile, log into LinkedIn once by hand, and leave it be.
CHROME_PROFILE_PATH="./.chrome-profile"

# Leave empty to use the bundled Chromium. Point it at your real Chrome for a
# genuine fingerprint (see README, "Why a local agent").
#   macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux: /usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=""

# How often the agent polls for due work, in seconds.
AGENT_TICK_SECONDS=90

# --- Working hours (agent stays idle outside these) ---
AGENT_TIMEZONE="America/Argentina/Buenos_Aires"
AGENT_ACTIVE_HOURS="09:00-19:00"
AGENT_ACTIVE_DAYS="1,2,3,4,5"

# --- LLM used to personalize invite notes and DMs ---
ANTHROPIC_API_KEY=""
