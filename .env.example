# Copiá este archivo a `.env` y completá lo que necesites.
#
#   cp .env.example .env
#
# Cada valor va en SU PROPIA LÍNEA, entre comillas, después del `=`.
# No pegues un valor dentro de otro.

# ---------------------------------------------------------------------------
# PASO 1 — Lo único que hace falta para `npm run check-session`
# ---------------------------------------------------------------------------

# Carpeta donde vive el perfil de Chrome que maneja el agente. Se crea sola.
# Ahí queda tu sesión de LinkedIn — nunca sale de tu máquina.
CHROME_PROFILE_PATH="./.chrome-profile"

# Dejalo vacío para usar el Chromium que se descargó con npm install.
# Apuntalo a tu Chrome real y el fingerprint deja de ser una aproximación.
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Linux:   /usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=""

# ---------------------------------------------------------------------------
# PASO 2 — Para que el agente empiece a trabajar (todavía no hace falta)
# ---------------------------------------------------------------------------

# Supabase > Project Settings > Database > Connection string > URI
DATABASE_URL=""

# Escribe las notas de invitación y clasifica las respuestas.
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=""

# Cada cuánto el agente busca trabajo pendiente, en segundos.
AGENT_TICK_SECONDS=90

# Fuera de esta ventana el agente no hace nada. Días: 1=lunes … 7=domingo.
AGENT_TIMEZONE="America/Argentina/Buenos_Aires"
AGENT_ACTIVE_HOURS="09:00-19:00"
AGENT_ACTIVE_DAYS="1,2,3,4,5"
